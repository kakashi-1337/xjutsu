# XJutsu v5 - Nginx Configuration Example
# by Dave Lester B. Mondina / ANBU Black Ops Security
#
# For use with short domain (e.g., 6u.gg) and HTTPS support
# Place this in /etc/nginx/sites-available/ and symlink to sites-enabled

# Redirect HTTP to HTTPS
server {
    listen 80;
    server_name 6u.gg;  # Replace with your short domain
    return 301 https://$host$request_uri;
}

# Main HTTPS server
server {
    listen 443 ssl http2;
    server_name 6u.gg;  # Replace with your short domain

    # SSL Configuration (Let's Encrypt / Certbot)
    ssl_certificate /etc/letsencrypt/live/6u.gg/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/6u.gg/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;

    # Modern SSL configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # HSTS (uncomment after testing)
    # add_header Strict-Transport-Security "max-age=63072000" always;

    # Security headers for dashboard pages (NOT for payload endpoints)
    # These are set per-location to avoid breaking CORS

    # Logging
    access_log /var/log/nginx/xjutsu_access.log;
    error_log /var/log/nginx/xjutsu_error.log;

    # Root endpoint - smart routing (serves JS or redirects to dashboard)
    location = / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Important: Pass Accept header for script detection
        proxy_set_header Accept $http_accept;
        proxy_set_header Sec-Fetch-Dest $http_sec_fetch_dest;
    }

    # Payload JavaScript endpoints (CORS enabled, no security headers)
    location ~ ^/(x\.js|m\.js|p/.*\.js)$ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CORS headers (also set by Django, but nginx can add them)
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;

        # Content type for JS
        add_header Content-Type "application/javascript; charset=utf-8" always;

        # No caching
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # ES Module endpoint (requires CORS for import())
    location ~ ^/m/.*\.js$ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CORS required for dynamic import()
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
        add_header Content-Type "application/javascript; charset=utf-8" always;
    }

    # API callback endpoint (CORS enabled)
    location /api/callback/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
    }

    # WebSocket endpoint for XSS callbacks
    location /ws/callback/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket timeout
        proxy_read_timeout 86400;
    }

    # WebSocket endpoint for dashboard (authenticated)
    location /ws/dashboard/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 86400;
    }

    # Dashboard and authenticated endpoints (with security headers)
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Security headers for dashboard pages
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'self' wss://$host ws://$host;" always;
    }

    # Static files
    location /static/ {
        alias /home/user/xjutsu/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Media files (screenshots, etc.)
    location /media/ {
        alias /home/user/xjutsu/media/;
        expires 7d;
    }
}

# ============================================================
# Caddy Alternative (simpler, auto-TLS)
# ============================================================
# Save as Caddyfile:
#
# 6u.gg {
#     reverse_proxy localhost:8000
#
#     @payload path /x.js /m.js /p/*.js /m/*.js
#     handle @payload {
#         header Access-Control-Allow-Origin *
#         header Content-Type "application/javascript; charset=utf-8"
#         reverse_proxy localhost:8000
#     }
#
#     @websocket {
#         path /ws/*
#         header Connection *Upgrade*
#         header Upgrade websocket
#     }
#     handle @websocket {
#         reverse_proxy localhost:8000
#     }
# }
# ============================================================

# ============================================================
# Quick Setup Commands:
# ============================================================
# 1. Install certbot: sudo apt install certbot python3-certbot-nginx
# 2. Get certificate: sudo certbot --nginx -d 6u.gg
# 3. Copy this config: sudo cp nginx.conf.example /etc/nginx/sites-available/xjutsu
# 4. Enable site: sudo ln -s /etc/nginx/sites-available/xjutsu /etc/nginx/sites-enabled/
# 5. Test config: sudo nginx -t
# 6. Reload nginx: sudo systemctl reload nginx
# ============================================================
